# Copy to .env and adjust before running the backend
NODE_ENV=development
PORT=3333
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sbll
CORS_ORIGIN=http://localhost:4173,http://localhost:4174

# Supabase Auth Configuration (required for CMS authentication)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# AI Service Configuration (optional - required for AI-assisted challenge generation)
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...
